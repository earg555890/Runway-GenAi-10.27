@echo off
rem Start PocketMoney for recording the live demo: answers really generated by NVIDIA Nemotron (ANSWER_MODE=live,
rem fast mode), Maya's data through Zetaris if it's up (else the local files, with a message), and open the browser.
rem 1. Checks Meterless Nightshift and asks one real question through it (demo_check.py).
rem 2. Stops any PocketMoney already on 8501, so the live settings apply.
rem 3. Moves the saved answers aside (.cache\answers -> .cache\answers-before-live-demo), so nothing is replayed.
rem    The first backup is kept; on later runs the answers saved since then are deleted instead. Live mode never
rem    reads saved answers anyway; this makes sure. "Start PocketMoney.bat" works as before afterwards.
setlocal
cd /d "%~dp0"
if not exist ".venv\Scripts\python.exe" (
  echo PocketMoney isn't installed yet. See README.md, "Try it in 2 minutes".
  pause
  exit /b 1
)

rem Fast answers on Nemotron Ultra (thinking off) through Nightshift: 5 of 5 full answers in 2-13 s in the Oct 26
rem spot check, against 2 of 5 for Lightning (Nightshift's own memory leaks earlier answers into Lightning's).
set "FAST_EXPLAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b"
echo Checking Meterless Nightshift and asking one real question...
set "DATA_BACKEND=local"
".venv\Scripts\python.exe" demo_check.py
if errorlevel 1 (
  echo.
  echo The live answers may be slow or fall back right now. Starting PocketMoney anyway.
)

call "%~dp0Stop PocketMoney.bat" >nul

powershell -NoProfile -Command "$c = New-Object Net.Sockets.TcpClient; try { $c.Connect('localhost', 10000); exit 0 } catch { exit 1 } finally { $c.Close() }"
if errorlevel 1 (
  echo Zetaris isn't reachable on port 10000, so PocketMoney reads Maya's local files.
  echo For the Zetaris beat, start Docker Desktop and the Zetaris containers, then run this again.
  set "DATA_BACKEND=local"
) else (
  echo Zetaris is up: PocketMoney reads Maya's data through Zetaris.
  set "DATA_BACKEND=zetaris"
)

powershell -NoProfile -Command "$a = '.cache\answers'; $b = '.cache\answers-before-live-demo'; if (Test-Path $a) { if (Test-Path $b) { Remove-Item -Recurse -Force $a } else { Move-Item $a $b }; Write-Host 'Saved answers moved aside: every answer will be generated live.' }"

echo Starting PocketMoney in live mode with %DATA_BACKEND% data...
set "ANSWER_MODE=live"
start "PocketMoney" cmd /c ".venv\Scripts\python.exe -m streamlit run ui\app.py --server.port 8501 --server.headless true || pause"
powershell -NoProfile -Command "$end = (Get-Date).AddSeconds(240); while ((Get-Date) -lt $end) { try { if ((Invoke-WebRequest -UseBasicParsing http://localhost:8501/_stcore/health -TimeoutSec 2).Content -eq 'ok') { exit 0 } } catch {}; Start-Sleep -Milliseconds 500 }; exit 1"
if errorlevel 1 (
  echo PocketMoney didn't start within 4 minutes. Look at the "PocketMoney" window for the error.
  pause
  exit /b 1
)
start "" http://localhost:8501
echo PocketMoney is running on http://localhost:8501 (live answers). Stop it with "Stop PocketMoney.bat".
endlocal
