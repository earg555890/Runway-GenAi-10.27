# Copy to .env. Works as-is for the demo (recorded answers, local data, no keys). .env is gitignored.

# NVIDIA Nemotron (OpenAI-compatible API). Add a key from build.nvidia.com for live answers.
NVIDIA_API_KEY=
NVIDIA_PLAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EXPLAIN_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Zetaris (local Docker install, JDBC). Only needed for DATA_BACKEND=zetaris.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USER=
ZETARIS_PASSWORD=
# Path to the Lightning JDBC driver jar (in the Zetaris bundle's jdbc/ folder) and to a Java 8+ install
ZETARIS_JDBC_JAR=
JAVA_HOME=

# Demo timeline: fixed "today" for the Fall 2026 demo (not a secret)
DEMO_TODAY=2026-10-26

# Data access: "local" (CSV files in data/maya) or "zetaris" (JDBC). Cache Zetaris results on disk: on|off
DATA_BACKEND=local
ZETARIS_CACHE=on
# Where the loader copies the CSVs inside the Zetaris driver container
ZETARIS_CONTAINER=zetaris-driver-1
ZETARIS_DATA_ROOT=/home/zetaris/customer-data/shared/runway

# Ask Runway: replay = recorded demo answers only (no key needed); cached = saved answers first, then live;
# live = always call the models (see config.py)
ANSWER_MODE=replay

# The check-in's greeting line by the fast model (on/off). Off = a fixed line.
AI_GREETING=on
