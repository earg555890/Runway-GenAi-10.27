# Copy to .env and fill in. .env is gitignored.

# NVIDIA Nemotron (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_PLAN_MODEL=
NVIDIA_EXPLAIN_MODEL=
NVIDIA_BASE_URL=

# Zetaris (local Docker install, JDBC)
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_JDBC_JAR=
JAVA_HOME=

# Demo timeline: fixed "today" for the Fall 2026 demo (not a secret)
DEMO_TODAY=2026-10-26

# Data access: "local" (CSV files in data/maya) or "zetaris" (JDBC). Cache Zetaris results on disk: on|off
DATA_BACKEND=local
ZETARIS_CACHE=on
# Where the loader copies the CSVs inside the Zetaris driver container
ZETARIS_CONTAINER=zetaris-driver-1
ZETARIS_DATA_ROOT=/home/zetaris/customer-data/shared/runway

# Ask Runway: live | cached | replay (see config.py)
ANSWER_MODE=cached
