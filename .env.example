# Copy to .env. Works as-is: SAMPLE_MODE=true runs PocketMoney with Maya's local files and the recorded answers, with no
# Zetaris, no Nightshift and no keys. For the full app (Zetaris + Meterless Nightshift), set SAMPLE_MODE=false and
# fill in the settings below. .env is gitignored.
SAMPLE_MODE=true

# AI provider: Meterless Nightshift (the default and primary). Nightshift serves the Meterless Runtime, an
# OpenAI-compatible API; the NVIDIA key goes in Nightshift (Setup > Providers), not here. Copy the Runtime URL and
# token from Nightshift's Console (Setup > Runtime). Leave the token empty and PocketMoney reads the runtime's own
# proxy-token file. Model ids are routing modes (meterless/auto, fast, deep...) or the concrete ids from discovery.
AI_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_ROUTING_MODE=meterless/auto
# NVIDIA Nemotron models, asked through Nightshift: PLAN and fast answers; Think harder.
NVIDIA_PLAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
THINK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: the fast-answer model through Nightshift (default: NVIDIA_PLAN_MODEL, Lightning). The live demo launcher
# uses Ultra here: with Nightshift's own memory on, it gave 5/5 full answers in 2-13 s vs 2/5 for Lightning.
FAST_EXPLAIN_MODEL=

# Optional fallback only: NVIDIA's API directly, used when Nightshift is unreachable (labelled "fallback" on the
# answer). AI_PROVIDER=nvidia makes it the provider. Think harder there uses NVIDIA_EXPLAIN_MODEL.
NVIDIA_API_KEY=
NVIDIA_EXPLAIN_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Zetaris (local Docker install, JDBC). Only needed for DATA_BACKEND=zetaris.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USER=
ZETARIS_PASSWORD=
# Path to the Lightning JDBC driver jar (in the Zetaris bundle's jdbc/ folder) and to a Java 8+ install
ZETARIS_JDBC_JAR=
JAVA_HOME=

# Demo timeline: fixed "today" for the Fall 2026 demo (not a secret)
DEMO_TODAY=2026-10-26

# Data access: "local" (CSV files in data/maya) or "zetaris" (JDBC). Cache Zetaris results on disk: on|off
DATA_BACKEND=local
ZETARIS_CACHE=on
# Where the loader copies the CSVs inside the Zetaris driver container
ZETARIS_CONTAINER=zetaris-driver-1
ZETARIS_DATA_ROOT=/home/zetaris/customer-data/shared/runway

# Ask PocketMoney: replay = recorded demo answers only (no key needed); cached = saved answers first, then live;
# live = always call the models (see config.py)
ANSWER_MODE=replay

# The check-in's greeting line by the fast model (on/off). Off = a fixed line.
AI_GREETING=on

# Optional: Firecrawl key for higher web-search limits (Find money > Found online). Keyless search works without it.
FIRECRAWL_API_KEY=
